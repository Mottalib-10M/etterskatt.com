---
import { footerCalcLinks, footerSalaryLinks, footerGuideLinks, footerInfoLinks } from '../../data/nav';

const currentYear = new Date().getFullYear();

const calcLinks = footerCalcLinks.nb;
const salaryLinks = footerSalaryLinks.nb;
const guideLinks = footerGuideLinks.nb;
const infoLinks = footerInfoLinks.nb;
---

<footer class="border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <nav aria-label="Bunntekstnavigasjon">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Kalkulatorer -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white">Kalkulatorer</h3>
        <ul class="mt-3 space-y-2">
          {calcLinks.map((link) => (
            <li><a href={link.href} class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Populære lønninger -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white">Populære lønninger</h3>
        <ul class="mt-3 space-y-2">
          {salaryLinks.map((link) => (
            <li><a href={link.href} class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Guider -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white">Guider</h3>
        <ul class="mt-3 space-y-2">
          {guideLinks.map((link) => (
            <li><a href={link.href} class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Om oss -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white">Om</h3>
        <ul class="mt-3 space-y-2">
          {infoLinks.map((link) => (
            <li><a href={link.href} class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400">{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
    </nav>

    <!-- Trust bar -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4 text-xs text-gray-500 dark:text-gray-400">
      <span>Skatteetaten 2025-data</span>
      <span>&middot;</span>
      <span>100% beregnet i nettleseren din</span>
      <span>&middot;</span>
      <span>Gratis og privat</span>
    </div>

    <!-- Disclaimer -->
    <p class="mt-4 text-center text-xs text-gray-400 dark:text-gray-500">
      Denne kalkulatoren gir estimater kun for informasjonsformål. Den er ikke skatterådgivning.
      Kontakt en kvalifisert skatterådgiver for personlig veiledning. Resultatene kan avvike fra din faktiske skatteforpliktelse.
    </p>

    <!-- Copyright -->
    <p class="mt-6 text-center text-xs text-gray-400 dark:text-gray-500">
      &copy; {currentYear} Lønn Etter Skatt. Alle rettigheter reservert.
    </p>
  </div>
</footer>
