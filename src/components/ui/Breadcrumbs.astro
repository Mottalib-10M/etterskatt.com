---
interface Props {
  items: { name: string; url: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Brødsmuler" class="mb-4">
  <ol class="flex flex-wrap items-center gap-1 text-sm text-gray-500 dark:text-gray-400">
    {items.map((item, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && (
          <svg class="h-4 w-4 text-gray-300 dark:text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M9 5l7 7-7 7" />
          </svg>
        )}
        {i === items.length - 1 ? (
          <span class="text-gray-700 dark:text-gray-300 font-medium" aria-current="page">{item.name}</span>
        ) : (
          <a href={item.url} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
