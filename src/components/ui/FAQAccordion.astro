---
interface Props {
  faqs: { question: string; answer: string }[];
}

const { faqs } = Astro.props;
---

<div class="space-y-3">
  {faqs.map((faq, i) => (
    <details class="group rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-dark-surface">
      <summary class="flex cursor-pointer items-center justify-between px-5 py-4 text-left font-medium text-gray-900 dark:text-white hover:bg-gray-50 dark:hover:bg-gray-800/50 rounded-xl transition-colors">
        <span>{faq.question}</span>
        <svg class="h-5 w-5 shrink-0 text-gray-400 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M12 6v12M6 12h12" />
        </svg>
      </summary>
      <div class="px-5 pb-4 text-gray-600 dark:text-gray-400 text-sm leading-relaxed" set:html={faq.answer} />
    </details>
  ))}
</div>

<script>
  document.querySelectorAll('details').forEach((detail) => {
    detail.addEventListener('toggle', () => {
      if (detail.open) {
        document.querySelectorAll('details[open]').forEach((other) => {
          if (other !== detail) other.removeAttribute('open');
        });
      }
    });
  });
</script>
