---
interface Props {
  current?: string;
}

const { current } = Astro.props;

const calculators = [
  { title: 'Lønnskalkulator', description: 'Beregn din lønn etter skatt med trinnskatt, trygdeavgift og fellesskatt', href: '/' },
  { title: 'Trinnskattkalkulator', description: 'Se nøyaktig hva du betaler i trinnskatt for hvert trinn', href: '/trinnskatt-kalkulator/' },
  { title: 'Trygdeavgiftkalkulator', description: 'Beregn trygdeavgift på din personinntekt', href: '/trygdeavgift-kalkulator/' },
  { title: 'Netto til brutto', description: 'Finn bruttolønn du trenger for ønsket nettolønn', href: '/netto-til-brutto/' },
  { title: 'Timelønnkalkulator', description: 'Konverter mellom timelønn og årslønn etter skatt', href: '/timelonn-kalkulator/' },
];

const related = calculators.filter(c => c.href !== current).slice(0, 4);
---

<section class="mt-12" aria-labelledby="related-heading">
  <h2 id="related-heading" class="text-xl font-bold text-gray-900 dark:text-white mb-4">
    Relaterte kalkulatorer
  </h2>
  <div class="grid gap-4 sm:grid-cols-2">
    {related.map((calc) => (
      <a href={calc.href} class="group rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-dark-surface p-5 hover:border-brand-500 dark:hover:border-brand-400 hover:shadow-md transition-all">
        <h3 class="font-semibold text-gray-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
          {calc.title}
        </h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{calc.description}</p>
      </a>
    ))}
  </div>
</section>
