---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import RelatedCalculators from '../components/ui/RelatedCalculators.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import '../styles/global.css';
import { buildCanonical, SITE_NAME, SITE_URL, OG_IMAGE, OG_IMAGE_WIDTH, OG_IMAGE_HEIGHT, LAST_UPDATED, webApplicationSchema, faqSchema, breadcrumbSchema, websiteSearchSchema, organizationSchema, personSchema } from '../lib/seo';
import { getAlternatePath } from '../i18n/routes';

interface Props {
  slug: string;
  title: string;
  metaTitle: string;
  metaDescription: string;
  h1: string;
  intro: string;
  faqs: { question: string; answer: string }[];
  lang?: string;
}

const { slug, title, metaTitle, metaDescription, h1, intro, faqs, lang = 'nb' } = Astro.props;
const canonical = buildCanonical(slug);

const currentPath = Astro.url.pathname;
const currentLang = lang === 'en' ? 'en' : 'nb';
const alternatePath = getAlternatePath(currentPath, currentLang as 'nb' | 'en');
const nbPath = currentLang === 'nb' ? `${SITE_URL}${currentPath}` : alternatePath ? `${SITE_URL}${alternatePath}` : null;
const enPath = currentLang === 'en' ? `${SITE_URL}${currentPath}` : alternatePath ? `${SITE_URL}${alternatePath}` : null;

const breadcrumbItems = [
  { name: 'Hjem', url: SITE_URL },
  { name: title, url: canonical },
];

const schemas: object[] = [
  webApplicationSchema(title, metaDescription, canonical),
  faqSchema(faqs),
  breadcrumbSchema(breadcrumbItems),
  organizationSchema(),
  personSchema(),
];

if (slug === '/') {
  schemas.push(websiteSearchSchema());
}
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{metaTitle}</title>
  <meta name="description" content={metaDescription} />
  <meta name="author" content="Mottalib Radif" />
  <link rel="canonical" href={canonical} />

  {/* Hreflang */}
  {nbPath && <link rel="alternate" hreflang="nb" href={nbPath} />}
  {enPath && <link rel="alternate" hreflang="en" href={enPath} />}
  {nbPath && <link rel="alternate" hreflang="x-default" href={nbPath} />}

  <meta property="og:type" content="website" />
  <meta property="og:title" content={metaTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'nb_NO'} />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:width" content={OG_IMAGE_WIDTH} />
  <meta property="og:image:height" content={OG_IMAGE_HEIGHT} />
  <meta property="og:image:alt" content={`${metaTitle} - Norsk lønnskalkulator`} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={metaTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={OG_IMAGE} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-700.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="manifest" href="/manifest.webmanifest" />

  {schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</head>
<body class="min-h-screen bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:text-gray-900 focus:rounded focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-blue-500">{lang === 'en' ? 'Skip to main content' : 'Hopp til hovedinnhold'}</a>

  <Header lang={lang} />

  <main id="main-content" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      {slug !== '/' && <Breadcrumbs items={breadcrumbItems} />}
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
        {h1}
      </h1>
      <p class="mt-3 text-lg text-gray-500 dark:text-gray-400">
        {intro}
      </p>
    </div>

    <slot />

    <div class="mt-8 flex items-center gap-4 rounded-lg border border-gray-200 dark:border-gray-700 px-5 py-4">
      <img src="/team/mottalib-radif.jpg" alt="Mottalib Radif" class="h-12 w-12 rounded-full object-cover" width="48" height="48" loading="lazy" />
      <div class="text-sm">
        <p class="font-semibold text-gray-900 dark:text-white">Av <a href="/om-oss/" class="text-brand-600 hover:underline dark:text-brand-400">Mottalib Radif</a></p>
        <p class="text-gray-500 dark:text-gray-400">MBA INSEAD &middot; Finansentusiast</p>
      </div>
    </div>

    <p class="mt-4 text-sm text-gray-400 dark:text-gray-500">
      Oppdatert for skatteår 2026 &middot; Kilde: Skatteetaten &middot; Sist verifisert {LAST_UPDATED}
    </p>

    <slot name="content" />

    {faqs.length > 0 && (
      <section class="mt-12" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="text-2xl font-bold text-gray-900 dark:text-white">
          Ofte stilte spørsmål
        </h2>
        <div class="mt-6">
          <FAQAccordion faqs={faqs} />
        </div>
      </section>
    )}

    <RelatedCalculators current={slug} />

    <!-- Sources -->
    <section class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-800">
      <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Kilder</h3>
      <ul class="text-xs text-gray-500 dark:text-gray-400 space-y-1">
        <li><a href="https://www.skatteetaten.no" target="_blank" rel="noopener noreferrer" class="hover:text-brand transition-colors">Skatteetaten</a> - Skattesatser, trinnskatt og fradrag</li>
        <li><a href="https://www.nav.no" target="_blank" rel="noopener noreferrer" class="hover:text-brand transition-colors">NAV</a> - Trygdeavgift og folketrygden</li>
      </ul>
    </section>
  </main>

  <Footer />
</body>
</html>
