---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { SITE_URL } from '../data/site-config';
import { getAlternatePath } from '../i18n/routes';

interface Props {
  title: string;
  description: string;
  publishDate: string;
  breadcrumbs: { label: string; href?: string }[];
  lang?: string;
}

const { title, description, publishDate, breadcrumbs, lang = 'nb' } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;

const currentPath = Astro.url.pathname;
const currentLang = lang === 'en' ? 'en' : 'nb';
const alternatePath = getAlternatePath(currentPath, currentLang as 'nb' | 'en');
const nbPath = currentLang === 'nb' ? `${SITE_URL}${currentPath}` : alternatePath ? `${SITE_URL}${alternatePath}` : null;
const enPath = currentLang === 'en' ? `${SITE_URL}${currentPath}` : alternatePath ? `${SITE_URL}${alternatePath}` : null;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | Lønn Etter Skatt</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  {/* Hreflang */}
  {nbPath && <link rel="alternate" hreflang="nb" href={nbPath} />}
  {enPath && <link rel="alternate" hreflang="en" href={enPath} />}
  {nbPath && <link rel="alternate" hreflang="x-default" href={nbPath} />}

  <meta property="og:type" content="article" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'nb_NO'} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="min-h-screen flex flex-col bg-gray-50 dark:bg-dark-bg text-gray-900 dark:text-gray-100 antialiased">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:text-gray-900 focus:rounded focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-blue-500">{lang === 'en' ? 'Skip to main content' : 'Hopp til hovedinnhold'}</a>
  <Header lang={lang} />
  <main id="main-content" class="flex-1 mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 lg:py-12">
    <nav class="text-sm text-gray-500 dark:text-gray-400 mb-6">
      {breadcrumbs.map((item, i) => (
        <>
          {i > 0 && <span class="mx-2">/</span>}
          {item.href ? <a href={item.href} class="hover:text-brand-600 dark:hover:text-brand-400">{item.label}</a> : <span class="text-gray-900 dark:text-white">{item.label}</span>}
        </>
      ))}
    </nav>
    <article class="prose prose-lg dark:prose-invert max-w-none">
      <header class="not-prose mb-8">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white">{title}</h1>
        <p class="mt-3 text-lg text-gray-600 dark:text-gray-400">{description}</p>
        <div class="flex items-center gap-4 mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
          <div class="flex-shrink-0 h-10 w-10 rounded-full bg-brand-100 dark:bg-brand-900/30 flex items-center justify-center text-brand-600 dark:text-brand-400 font-bold text-sm">MR</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">
            <p class="font-medium text-gray-900 dark:text-white">Mottalib Radif, MBA</p>
            <p>Publisert {new Date(publishDate).toLocaleDateString('nb-NO', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
          </div>
        </div>
      </header>
      <slot />
    </article>
  </main>
  <Footer />
</body>
</html>
