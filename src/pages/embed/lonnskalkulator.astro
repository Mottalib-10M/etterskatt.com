---
/** Page embarquable (iframe) : calculateur nu, lien de crédit visible (RECETTE §13). */
import '../../styles/global.css';
import NoCalculator from '../../components/calc/NoCalculator';
import { SITE_URL } from '../../data/site-config';
---
<!doctype html>
<html lang="nb-NO">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lønnskalkulator 2026, widget</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/nb/`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <NoCalculator client:load />
    <p class="mt-2 text-center text-xs text-navy-500"><a href={`${SITE_URL}/nb/`} target="_blank" rel="noopener" class="hover:underline">etterskatt.com</a> · skatt beregnet i nettleseren din</p>
  </body>
</html>
