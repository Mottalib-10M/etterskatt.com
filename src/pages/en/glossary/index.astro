    <div id="T">
      <h3 class="text-lg font-bold text-gray-900 dark:text-white border-b border-gray-200 dark:border-gray-700 pb-2 mb-4">T</h3>
      {defined_terms.filter(t => t.term.startsWith('T')).map(t => (
