---
import GuideLayout from '../../../layouts/GuideLayout.astro';

const defined_terms = [
  { term: 'AFP (Contractual Early Retirement Pension)', definition: 'AFP is a pension scheme that allows you to retire from the age of 62. It is based on agreements between employers and trade unions. AFP pension is paid in addition to the old-age pension from the National Insurance Scheme and is a lifelong benefit.' },
  { term: 'A-melding (Monthly Tax Report)', definition: 'The A-melding is a monthly report that employers submit to Skatteetaten with information about salaries, tax deductions, and employer social security contributions for all employees. It is submitted electronically via Altinn.' },
  { term: 'Arbeidsgiveravgift (Employer Social Security Contribution)', definition: 'A contribution paid by your employer to the National Insurance Scheme, calculated on your gross salary. The rate varies between 0% and 14.1% depending on the geographical zone of the business. It funds social security benefits but does not appear on your payslip.' },
  { term: 'BSU (Youth Housing Savings)', definition: 'BSU is a tax-favored savings scheme for people under 34 years old. You can save up to NOK 27,500 per year and receive a 10% tax deduction on the amount saved. The maximum total savings is NOK 300,000. The BSU deduction is subtracted directly from your tax.' },
  { term: 'Bruttolønn (Gross Salary)', definition: 'Gross salary is your total pay before tax and other deductions. It is the amount stated in your employment contract. Preliminary tax (forskuddstrekk) is deducted from the gross salary, and the remainder is your net salary. Calculate your net pay with our <a href="/en/">salary calculator</a>.' },
  { term: 'Fagforeningskontingent (Union Membership Fee)', definition: 'The monthly fee paid to your trade union. You can claim a tax deduction for up to NOK 7,700 per year (2026) in union fees. The deduction reduces your ordinary income and results in 22% lower tax on the amount.' },
  { term: 'Fellesskatt (Common Tax)', definition: 'Common tax is a flat 22% tax on ordinary income (income after deductions). The rate is the same for everyone regardless of municipality and constitutes the main part of the tax on ordinary income in Norway.' },
  { term: 'Feriepenger (Holiday Pay)', definition: 'Holiday pay is the salary you receive during your vacation. Employers set aside 10.2% of your gross salary (12% for employees over 60) for holiday pay. Holiday pay is usually paid out in June and replaces your regular salary during the vacation period.' },
  { term: 'Formueskatt (Wealth Tax)', definition: 'Wealth tax is paid by individuals with net wealth exceeding the threshold of NOK 1,760,000 (2026). The rate is 1.0% to the municipality and 0.3% to the state on wealth between the threshold and NOK 20,000,000, and 0.4% to the state on wealth above this.' },
  { term: 'Forskuddstrekk (Preliminary Tax Deduction)', definition: 'Forskuddstrekk is the tax your employer deducts from your salary each month and pays to Skatteetaten. The amount is calculated based on your tax card, either as table-based deduction (tabelltrekk) or percentage deduction (prosenttrekk). The final tax settlement comes the following year.' },
  { term: 'Grunnbeløpet (G) (National Insurance Base Amount)', definition: 'The base amount (G) is set annually by the Parliament and used to calculate National Insurance benefits. As of May 1, 2026, 1G = NOK 130,512. It regulates pensions, sick pay, unemployment benefits, and other NAV benefits.' },
  { term: 'Minstefradrag (Standard Deduction)', definition: 'The standard deduction is an automatic deduction for all salary earners. It equals 46% of gross salary, capped at NOK 114,950 per year (2026). The standard deduction reduces your ordinary income and thereby the tax you pay.' },
  { term: 'NAV (Norwegian Labour and Welfare Administration)', definition: 'NAV administers Norway\'s social security schemes, labor market programs, and social assistance. NAV pays out benefits including sick pay, unemployment benefits, parental benefits, old-age pension, and disability benefits. NAV is partially funded through the social security contribution (trygdeavgift).' },
  { term: 'Nettolønn (Net Salary)', definition: 'Net salary is the amount you actually receive after tax and other deductions have been subtracted from your gross salary. This is the amount deposited into your bank account each month. Calculate your net salary with our <a href="/en/">salary calculator</a>.' },
  { term: 'OTP (Mandatory Occupational Pension)', definition: 'OTP is the statutory pension scheme requiring employers to contribute at least 2% of your salary to a pension fund. The contribution is calculated on salary between 1G and 12G. OTP supplements the National Insurance pension and ensures all employees receive an occupational pension.' },
  { term: 'Overtidstillegg (Overtime Supplement)', definition: 'Overtime supplement is the extra compensation for work beyond normal working hours. Under the Working Environment Act, the overtime supplement must be at least 40% of the agreed hourly wage. Overtime pay is taxable income and is included in the calculation basis for bracket tax.' },
  { term: 'Pensjonsinnskudd (Pension Contribution)', definition: 'Pension contribution is the portion of salary set aside for occupational pension. Employers typically contribute between 2% and 7% of salary to the pension scheme. The contribution is deducted before tax and thereby reduces your taxable income.' },
  { term: 'Personfradrag (Personal Allowance)', definition: 'The personal allowance is a tax-free amount deducted from ordinary income when calculating tax. In 2026, the personal allowance is NOK 70,000 (class 1). The allowance is applied automatically and reduces the basis for the 22% common tax.' },
  { term: 'Prosenttrekk (Percentage Deduction)', definition: 'Percentage deduction is a method of tax deduction where the employer deducts a fixed percentage of your gross salary. It is typically used for secondary income, short-term employment, or when table-based deduction is not suitable. The percentage is specified on your tax card.' },
  { term: 'Skattemelding (Tax Return)', definition: 'The tax return is an annual statement of your income, deductions, and assets sent by Skatteetaten. You receive it in March-April and must submit any changes by April 30. The tax return forms the basis for the final tax settlement.' },
  { term: 'Skattefri inntekt (Tax-Free Income)', definition: 'Tax-free income is income you do not pay tax on. Examples include child benefit, cash-for-care benefit, housing allowance, scholarships from Lanekassen, and gains from selling your primary residence under certain rules.' },
  { term: 'Skatteoppgjør (Tax Settlement)', definition: 'The tax settlement is the final statement from Skatteetaten showing whether you have paid too much or too little tax. If you overpaid, you receive a refund. If you underpaid, you must pay residual tax. The settlement usually arrives in June.' },
  { term: 'Skatteetaten (Norwegian Tax Administration)', definition: 'Skatteetaten is the Norwegian government agency responsible for administering the tax system. It sets tax tables, processes tax returns, calculates tax settlements, and manages the National Population Register. Official website: skatteetaten.no.' },
  { term: 'Skattekort (Tax Card)', definition: 'The tax card is the document from Skatteetaten that specifies how much tax your employer should deduct from your salary. It contains either a tax table (tabelltrekk) or a percentage rate (prosenttrekk) and is retrieved electronically by the employer.' },
  { term: 'Tabelltrekk (Table-Based Tax Deduction)', definition: 'Table-based deduction is the most common method of payroll tax deduction. Employers use Skatteetaten tax tables to calculate the correct deduction based on monthly salary, tax municipality, and deductions. The table accounts for personal allowance and standard deduction.' },
  { term: 'Trinnskatt (Bracket Tax)', definition: 'Bracket tax is Norway\'s progressive income tax calculated directly on gross personal income without deductions. In 2026, it has five brackets with rates from 1.7% to 17.6%. Bracket tax starts on income above NOK 217,400. Learn more in our <a href="/guides/trinnskatt-forklart/">bracket tax guide</a>.' },
  { term: 'Trygdeavgift (Social Security Contribution)', definition: 'Trygdeavgift is a mandatory contribution to the National Insurance Scheme. For employees, the rate is 7.9% of gross personal income (2026). Income below NOK 69,650 is exempt. It funds sick pay, parental benefits, unemployment benefits, and old-age pension. Calculate it with our <a href="/trygdeavgift-kalkulator/">calculator</a>.' },
];

const defined_terms_schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Norwegian Tax Glossary 2026',
  description: 'Glossary of Norwegian tax terms used in salary calculation and income tax filing in Norway.',
  url: 'https://lonnetterskatt.no/en/glossary/',
  inLanguage: 'en',
  hasDefinedTerm: defined_terms.map(t => ({
    '@type': 'DefinedTerm',
    name: t.term,
    description: t.definition.replace(/<[^>]*>/g, ''),
    inDefinedTermSet: 'https://lonnetterskatt.no/en/glossary/',
  })),
});

const letters = ['A', 'B', 'F', 'G', 'M', 'N', 'O', 'P', 'S', 'T'];
---

<GuideLayout
  title="Norwegian Tax Glossary 2026 | All Key Terms Explained"
  description="Complete glossary of Norwegian tax terms with English explanations. Understand trinnskatt, trygdeavgift, minstefradrag, feriepenger and more from Skatteetaten."
  publishDate="2026-06-01"
  lang="en"
  breadcrumbs={[
    { label: 'Home', href: '/en/' },
    { label: 'Glossary' },
  ]}
>
  <script type="application/ld+json" set:html={defined_terms_schema} />

  <h2>Norwegian Tax Glossary A-Z</h2>
  <p>This glossary explains the most common Norwegian tax terms you will encounter on your payslip, tax return, and when calculating your net salary. All terms include the original Norwegian name with English translations. Based on official definitions from Skatteetaten for the 2026 tax year.</p>

  <nav class="not-prose flex flex-wrap gap-2 my-6" aria-label="Quick navigation A-Z">
    {letters.map(letter => (
      <a href={`#${letter}`} class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-gray-200 dark:border-gray-700 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-brand-50 dark:hover:bg-brand-900/20 hover:text-brand-600 dark:hover:text-brand-400 hover:border-brand-300 transition-colors">
        {letter}
      </a>
    ))}
  </nav>

  <dl class="not-prose space-y-6 mt-8">
    <div id="A">
      <h3 class="text-lg font-bold text-gray-900 dark:text-white border-b border-gray-200 dark:border-gray-700 pb-2 mb-4">A</h3>
      {defined_terms.filter(t => t.term.startsWith('A')).map(t => (
        <div class="mb-4">
          <dt class="font-semibold text-gray-900 dark:text-white">{t.term}</dt>
          <dd class="mt-1 text-gray-600 dark:text-gray-400 leading-relaxed" set:html={t.definition} />
        </div>
      ))}
    </div>

    <div id="B">
      <h3 class="text-lg font-bold text-gray-900 dark:text-white border-b border-gray-200 dark:border-gray-700 pb-2 mb-4">B</h3>
      {defined_terms.filter(t => t.term.startsWith('B')).map(t => (
        <div class="mb-4">
          <dt class="font-semibold text-gray-900 dark:text-white">{t.term}</dt>
          <dd class="mt-1 text-gray-600 dark:text-gray-400 leading-relaxed" set:html={t.definition} />
        </div>
      ))}
    </div>

    <div id="F">
      <h3 class="text-lg font-bold text-gray-900 dark:text-white border-b border-gray-200 dark:border-gray-700 pb-2 mb-4">F</h3>
      {defined_terms.filter(t => t.term.startsWith('F')).map(t => (
        <div class="mb-4">
          <dt class="font-semibold text-gray-900 dark:text-white">{t.term}</dt>
          <dd class="mt-1 text-gray-600 dark:text-gray-400 leading-relaxed" set:html={t.definition} />
        </div>
      ))}
    </div>

    <div id="G">
      <h3 class="text-lg font-bold text-gray-900 dark:text-white border-b border-gray-200 dark:border-gray-700 pb-2 mb-4">G</h3>
      {defined_terms.filter(t => t.term.startsWith('G')).map(t => (
        <div class="mb-4">
          <dt class="font-semibold text-gray-900 dark:text-white">{t.term}</dt>
          <dd class="mt-1 text-gray-600 dark:text-gray-400 leading-relaxed" set:html={t.definition} />
        </div>
      ))}
    </div>

    <div id="M">
      <h3 class="text-lg font-bold text-gray-900 dark:text-white border-b border-gray-200 dark:border-gray-700 pb-2 mb-4">M</h3>
      {defined_terms.filter(t => t.term.startsWith('M')).map(t => (
        <div class="mb-4">
          <dt class="font-semibold text-gray-900 dark:text-white">{t.term}</dt>
          <dd class="mt-1 text-gray-600 dark:text-gray-400 leading-relaxed" set:html={t.definition} />
        </div>
      ))}
    </div>

    <div id="N">
      <h3 class="text-lg font-bold text-gray-900 dark:text-white border-b border-gray-200 dark:border-gray-700 pb-2 mb-4">N</h3>
      {defined_terms.filter(t => t.term.startsWith('N')).map(t => (
        <div class="mb-4">
          <dt class="font-semibold text-gray-900 dark:text-white">{t.term}</dt>
          <dd class="mt-1 text-gray-600 dark:text-gray-400 leading-relaxed" set:html={t.definition} />
        </div>
      ))}
    </div>

    <div id="O">
      <h3 class="text-lg font-bold text-gray-900 dark:text-white border-b border-gray-200 dark:border-gray-700 pb-2 mb-4">O</h3>
      {defined_terms.filter(t => t.term.startsWith('O')).map(t => (
        <div class="mb-4">
          <dt class="font-semibold text-gray-900 dark:text-white">{t.term}</dt>
          <dd class="mt-1 text-gray-600 dark:text-gray-400 leading-relaxed" set:html={t.definition} />
        </div>
      ))}
    </div>

    <div id="P">
      <h3 class="text-lg font-bold text-gray-900 dark:text-white border-b border-gray-200 dark:border-gray-700 pb-2 mb-4">P</h3>
      {defined_terms.filter(t => t.term.startsWith('P')).map(t => (
        <div class="mb-4">
          <dt class="font-semibold text-gray-900 dark:text-white">{t.term}</dt>
          <dd class="mt-1 text-gray-600 dark:text-gray-400 leading-relaxed" set:html={t.definition} />
        </div>
      ))}
    </div>

    <div id="S">
      <h3 class="text-lg font-bold text-gray-900 dark:text-white border-b border-gray-200 dark:border-gray-700 pb-2 mb-4">S</h3>
      {defined_terms.filter(t => t.term.startsWith('S')).map(t => (
        <div class="mb-4">
          <dt class="font-semibold text-gray-900 dark:text-white">{t.term}</dt>
