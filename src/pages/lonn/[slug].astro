---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import LonnsKalkulator from '../../components/calculators/LonnsKalkulator';
import { calculateTakeHome } from '../../lib/tax-engine-no';
import { formatCurrency, formatPercent } from '../../lib/format';

export function getStaticPaths() {
  const amounts = [300000, 350000, 400000, 450000, 500000, 550000, 600000, 650000, 700000, 750000, 800000, 900000, 1000000];
  return amounts.map((amount) => ({
    params: { slug: `${amount}-kr` },
    props: { amount },
  }));
}

const { amount } = Astro.props;
const result = calculateTakeHome({ bruttoAarlig: amount });
const formattedAmount = new Intl.NumberFormat('nb-NO').format(amount);
const formattedNet = formatCurrency(result.nettoAarlig);
const formattedMonthly = formatCurrency(result.nettoMaanedlig);

const faqs = [
  {
    question: `Hvor mye skatt betaler man på ${formattedAmount} kr i årslønn?`,
    answer: `Med en årslønn på ${formattedAmount} kr betaler du ca. ${formatCurrency(result.totalSkatt)} i total skatt for 2026. Dette inkluderer trinnskatt (${formatCurrency(result.trinnskatt)}), trygdeavgift (${formatCurrency(result.trygdeavgift)}) og fellesskatt (${formatCurrency(result.fellesskatt)}). Din effektive skattesats er ${formatPercent(result.effektivSkattesats)}.`,
  },
  {
    question: `Hva er nettolønn på ${formattedAmount} kr?`,
    answer: `Med en bruttolønn på ${formattedAmount} kr per år sitter du igjen med ca. ${formattedNet} etter skatt i 2026. Det tilsvarer ${formattedMonthly} per måned. Beregningen inkluderer minstefradrag på ${formatCurrency(result.minstefradrag)} og personfradrag på ${formatCurrency(result.personfradrag)}.`,
  },
  {
    question: `Hva er marginalskatten på ${formattedAmount} kr?`,
    answer: `Med en inntekt på ${formattedAmount} kr er marginalskatten ca. ${formatPercent(result.marginalsats)}. Det betyr at for hver ekstra krone du tjener, går ${formatPercent(result.marginalsats)} til skatt. Marginalskatten er høyere enn den effektive skattesatsen (${formatPercent(result.effektivSkattesats)}) fordi den kun viser skattesatsen på den siste kronen.`,
  },
  {
    question: `Hva er effektiv skattesats på ${formattedAmount} kr?`,
    answer: `Den effektive skattesatsen på ${formattedAmount} kr er ${formatPercent(result.effektivSkattesats)} i 2026. Det betyr at du i gjennomsnitt betaler ${formatPercent(result.effektivSkattesats)} av bruttolønnen din i skatt. Resterende ${formatPercent(100 - result.effektivSkattesats)} beholder du som nettolønn.`,
  },
  {
    question: `Hvordan fordeles skatten på ${formattedAmount} kr?`,
    answer: `Skatten på ${formattedAmount} kr fordeles slik: Trinnskatt: ${formatCurrency(result.trinnskatt)}, Trygdeavgift (7,9%): ${formatCurrency(result.trygdeavgift)}, Fellesskatt (22%): ${formatCurrency(result.fellesskatt)}. Total skatt: ${formatCurrency(result.totalSkatt)}. Minstefradrag (${formatCurrency(result.minstefradrag)}) og personfradrag (${formatCurrency(result.personfradrag)}) reduserer grunnlaget for fellesskatt.`,
  },
];
---

<CalculatorLayout
  slug={`/lonn/${amount}-kr`}
  title={`${formattedAmount} kr lønn etter skatt`}
  metaTitle={`${formattedAmount} kr lønn etter skatt 2026 | Netto ${formattedNet}`}
  metaDescription={`Se hva du sitter igjen med av ${formattedAmount} kr i årslønn etter skatt i Norge 2026. Nettolønn: ca. ${formattedNet}. Trinnskatt, trygdeavgift og fellesskatt beregnet.`}
  h1={`${formattedAmount} kr lønn etter skatt 2026`}
  intro={`Med en bruttolønn på ${formattedAmount} kr per år sitter du igjen med ca. ${formattedNet} etter skatt. Det tilsvarer ${formattedMonthly} per måned. Beregnet med Skatteetatens satser for 2026.`}
  faqs={faqs}
>
  <LonnsKalkulator client:idle defaultGross={amount} />

  <section class="mt-12 prose prose-gray dark:prose-invert max-w-none" slot="content">
    <h2>Skatteberegning for {formattedAmount} kr i 2026</h2>
    <p>
      En årslønn på {formattedAmount} kr gir en nettolønn på ca. {formattedNet} etter alle skatter i Norge for 2026. Den effektive skattesatsen er {formatPercent(result.effektivSkattesats)}, noe som betyr at du betaler {formatCurrency(result.totalSkatt)} i total skatt. Marginalskatten er {formatPercent(result.marginalsats)}, som viser hva du betaler i skatt på den neste kronen du tjener.
    </p>

    <h3>Detaljert skattefordeling</h3>
    <p>
      Din totale skatt på {formattedAmount} kr fordeles mellom tre hovedkomponenter: Trinnskatten utgjør {formatCurrency(result.trinnskatt)} og beregnes direkte på personinntekt. Trygdeavgiften er {formatCurrency(result.trygdeavgift)} (7,9% av personinntekt). Felleskatten er {formatCurrency(result.fellesskatt)} og beregnes med 22% på alminnelig inntekt etter fradrag. Du får minstefradrag på {formatCurrency(result.minstefradrag)} og personfradrag på {formatCurrency(result.personfradrag)}.
    </p>

    <h3>Månedlig og ukentlig oversikt</h3>
    <p>
      Med en årslønn på {formattedAmount} kr mottar du ca. {formattedMonthly} netto per måned. Ukentlig tilsvarer dette ca. {formatCurrency(result.nettoUkentlig)}. Annenhver uke (for de med to-ukers lønnsperiode) mottar du ca. {formatCurrency(result.nettoAnnenhverUke)}. Husk at disse tallene er gjennomsnitt, og den faktiske utbetalingen kan variere gjennom året, spesielt i juni når feriepenger utbetales. Brutto månedslønn er ca. {formatCurrency(amount / 12)}.
    </p>
  </section>
</CalculatorLayout>
