---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import LonnsKalkulator from '../../components/calculators/LonnsKalkulator';

const faqs = [
  { question: 'Hvordan omregner jeg timelønn til årslønn?', answer: 'Multipliser timelønnen med antall timer per uke og 52 uker. For eksempel: 250 kr/time × 37,5 timer × 52 = 487 500 kr/år.' },
  { question: 'Hvor mange timer jobber man normalt i Norge?', answer: 'Normal arbeidstid i Norge er 37,5 timer per uke (7,5 timer per dag), som gir ca. 1 950 timer per år.' },
];
---

<CalculatorLayout
  slug="/timelonn-kalkulator"
  title="Timelønnkalkulator"
  metaTitle="Timelønnkalkulator Norge 2025 | Timelønn til årslønn"
  metaDescription="Omregn timelønn til årslønn og beregn nettolønn i Norge 2025. Se hva du får utbetalt per time etter skatt. Gratis kalkulator med Skatteetatens offisielle data."
  h1="Timelønnkalkulator 2025"
  intro="Omregn din timelønn til årslønn og se nettolønn per time etter skatt."
  faqs={faqs}
>
  <LonnsKalkulator client:idle />

  <div slot="content" class="prose prose-lg dark:prose-invert max-w-none mt-12">
    <h2>Timelønn til årslønn: omregningstabell</h2>
    <p>Basert på 37,5 timers arbeidsuke (1 950 timer/år):</p>
    <table>
      <thead><tr><th>Timelønn</th><th>Årslønn</th><th>Nettolønn/år (ca)</th></tr></thead>
      <tbody>
        <tr><td>200 kr</td><td>390 000 kr</td><td>~310 000 kr</td></tr>
        <tr><td>250 kr</td><td>487 500 kr</td><td>~380 000 kr</td></tr>
        <tr><td>300 kr</td><td>585 000 kr</td><td>~440 000 kr</td></tr>
        <tr><td>350 kr</td><td>682 500 kr</td><td>~500 000 kr</td></tr>
        <tr><td>400 kr</td><td>780 000 kr</td><td>~550 000 kr</td></tr>
        <tr><td>500 kr</td><td>975 000 kr</td><td>~650 000 kr</td></tr>
      </tbody>
    </table>
  </div>
</CalculatorLayout>
