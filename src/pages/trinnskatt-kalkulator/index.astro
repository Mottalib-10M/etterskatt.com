---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import LonnsKalkulator from '../../components/calculators/LonnsKalkulator';

const faqs = [
  { question: 'Hva er trinnskatt?', answer: 'Trinnskatt er en progressiv skatt på personinntekt (bruttolønn). Den har fem trinn i 2026 med satser fra 1,7% til 17,6%. Trinnskatten beregnes på bruttoinntekt uten fradrag.' },
  { question: 'Hvordan beregnes trinnskatt?', answer: 'Du betaler kun den høyere satsen på inntekt over grensen for hvert trinn. For eksempel: Med 600 000 kr i brutto betaler du 0% på de første 217 400 kr, 1,7% på 217 400–306 050 kr, og 4,0% på 306 050–600 000 kr.' },
];
---

<CalculatorLayout
  slug="/trinnskatt-kalkulator"
  title="Trinnskattkalkulator"
  metaTitle="Trinnskattkalkulator Norge 2026 | Beregn din trinnskatt"
  metaDescription="Beregn din trinnskatt for 2026 med alle fem trinn fra 1,7% til 17,6%. Se nøyaktig hvor mye trinnskatt du betaler basert på din bruttolønn. Gratis kalkulator."
  h1="Trinnskattkalkulator 2026"
  intro="Se din trinnskatt trinn for trinn med Skatteetatens satser for 2026."
  faqs={faqs}
>
  <LonnsKalkulator client:idle />

  <div slot="content" class="prose prose-lg dark:prose-invert max-w-none mt-12">
    <h2>Trinnskatt-satser 2026</h2>
    <table>
      <thead><tr><th>Trinn</th><th>Inntektsintervall</th><th>Sats</th></tr></thead>
      <tbody>
        <tr><td>—</td><td>0 – 217 400 kr</td><td>0%</td></tr>
        <tr><td>1</td><td>217 400 – 306 050 kr</td><td>1,7%</td></tr>
        <tr><td>2</td><td>306 050 – 697 150 kr</td><td>4,0%</td></tr>
        <tr><td>3</td><td>697 150 – 942 400 kr</td><td>13,6%</td></tr>
        <tr><td>4</td><td>942 400 – 1 410 750 kr</td><td>16,6%</td></tr>
        <tr><td>5</td><td>Over 1 410 750 kr</td><td>17,6%</td></tr>
      </tbody>
    </table>

    <h3>Trinnskatt på vanlige lønninger</h3>
    <table>
      <thead><tr><th>Bruttolønn</th><th>Trinnskatt</th></tr></thead>
      <tbody>
        <tr><td>400 000 kr</td><td>~5 264 kr</td></tr>
        <tr><td>500 000 kr</td><td>~9 264 kr</td></tr>
        <tr><td>600 000 kr</td><td>~13 264 kr</td></tr>
        <tr><td>700 000 kr</td><td>~17 651 kr</td></tr>
        <tr><td>800 000 kr</td><td>~31 399 kr</td></tr>
        <tr><td>1 000 000 kr</td><td>~64 615 kr</td></tr>
      </tbody>
    </table>
  </div>
</CalculatorLayout>
