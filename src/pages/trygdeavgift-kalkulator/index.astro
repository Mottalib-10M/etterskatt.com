---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import LonnsKalkulator from '../../components/calculators/LonnsKalkulator';

const faqs = [
  { question: 'Hva er trygdeavgift?', answer: 'Trygdeavgift er en avgift alle yrkesaktive betaler til folketrygden (NAV). Satsen for lønnsmottakere er 7,9% i 2025, beregnet på brutto personinntekt over 69 650 kr.' },
  { question: 'Hva finansierer trygdeavgiften?', answer: 'Trygdeavgiften finansierer folketrygdens ytelser: sykepenger, foreldrepenger, dagpenger, alderspensjon, uføretrygd og andre NAV-ytelser.' },
];
---

<CalculatorLayout
  slug="/trygdeavgift-kalkulator"
  title="Trygdeavgiftkalkulator"
  metaTitle="Trygdeavgiftkalkulator 2025 | Beregn 7,9% avgiften"
  metaDescription="Beregn din trygdeavgift for 2025. Se hvor mye du betaler i trygdeavgift (7,9%) basert på din bruttolønn. Fribeløp, innfasing og folketrygdens ytelser forklart."
  h1="Trygdeavgiftkalkulator 2025"
  intro="Beregn din trygdeavgift (7,9%) og se hvordan den påvirker nettolønnen din."
  faqs={faqs}
>
  <LonnsKalkulator client:idle />

  <div slot="content" class="prose prose-lg dark:prose-invert max-w-none mt-12">
    <h2>Trygdeavgift-satser 2025</h2>
    <table>
      <thead><tr><th>Inntektstype</th><th>Sats</th></tr></thead>
      <tbody>
        <tr><td>Lønnsinntekt</td><td>7,9%</td></tr>
        <tr><td>Næringsinntekt</td><td>11,0%</td></tr>
        <tr><td>Pensjon</td><td>5,1%</td></tr>
      </tbody>
    </table>
    <p>Inntekt under 69 650 kr er fritatt for trygdeavgift. Mellom 69 650 kr og full innfasing beregnes avgiften med en lavere sats (25,8%).</p>

    <h3>Trygdeavgift på vanlige lønninger</h3>
    <table>
      <thead><tr><th>Bruttolønn</th><th>Trygdeavgift</th><th>Per måned</th></tr></thead>
      <tbody>
        <tr><td>400 000 kr</td><td>31 600 kr</td><td>2 633 kr</td></tr>
        <tr><td>500 000 kr</td><td>39 500 kr</td><td>3 292 kr</td></tr>
        <tr><td>600 000 kr</td><td>47 400 kr</td><td>3 950 kr</td></tr>
        <tr><td>700 000 kr</td><td>55 300 kr</td><td>4 608 kr</td></tr>
        <tr><td>800 000 kr</td><td>63 200 kr</td><td>5 267 kr</td></tr>
      </tbody>
    </table>
  </div>
</CalculatorLayout>
